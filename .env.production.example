# Production settings. Copy to .env.production, fill in every empty value, then check it:
#   python3 libs/core/mindnest_core/prodcheck.py .env.production
# This file never goes into git (.env.production is git-ignored). Full guide: docs/runbooks/production.md

# --- Where students will open the site --------------------------------------------------------
# The domain name only (no https://). Its DNS must point at this machine before first start.
DOMAIN=
# Certificate expiry notices go here.
ACME_EMAIL=

# --- Secrets: make each one different. Generate with:  openssl rand -hex 24 ------------------
# SECRET_KEY locks the AI provider keys students save. Use 40+ characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep a copy somewhere safe and separate from the server. If it is lost, every saved key is
# unreadable and students must enter their keys again. Never change it by accident.
SECRET_KEY=
# Database owner (migrations only), the app role (everything else) and the evaluation role.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
EVAL_DB_PASSWORD=
REDIS_PASSWORD=
# File storage login (used by the bundled storage, or given to you by your storage provider).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mindnest-materials
# Leave empty to use the bundled storage (profile "storage"). For a hosted bucket put its
# https:// address here and drop "storage" from COMPOSE_PROFILES.
S3_ENDPOINT_URL=

# --- Optional parts: storage = bundled file storage, models = embeddings on this machine's CPU -
COMPOSE_PROFILES=storage,models
# Only if you run the model service elsewhere (for example a GPU machine). Leave empty otherwise.
MODEL_SERVICE_URL=

# --- Email (verification and password reset). Use your mail provider's SMTP details -----------
SMTP_HOST=
SMTP_PORT=587
# starttls for port 587, tls for port 465
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MindNest AI <no-reply@your-domain>

# --- Sign in with Google and Calendar sync (optional; leave both empty to switch off) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Agent traces in LangSmith (optional) -------------------------------------------------------
# When on, each agent run is recorded in your LangSmith project so you can see which agent was
# chosen, which tools ran and how long each step took. Only MASKED text is sent: phone numbers,
# e-mail addresses, ID numbers and key-shaped text are replaced before anything leaves the server.
AGENT_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mindnest-ai

# --- Guardrails (NeMo Guardrails around every chat run) -----------------------------------------
# Keep GUARDRAILS_ENABLED on. GUARDRAILS_JUDGE lets a risky-looking message get one short second
# opinion from the student's own model; off = rules only. See docs/agents.md, Part 5.
GUARDRAILS_ENABLED=true
GUARDRAILS_JUDGE=true
GUARDRAILS_JUDGE_TIMEOUT_SECONDS=8

# --- Backups (scripts/backup.sh) --------------------------------------------------------------
# Where backups are written, and how many days to keep them.
BACKUP_DIR=/srv/mindnest-backups
BACKUP_KEEP_DAYS=14
# Optional: encrypt backup files with this passphrase (needs openssl on the server).
BACKUP_PASSPHRASE=
