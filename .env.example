# Copy to .env for running scripts or tests outside Docker.
# These are development defaults only. Never reuse them outside your own machine.
APP_NAME=MindNest AI
ENVIRONMENT=development

# The app role is subject to row-level security. The owner role runs migrations.
DATABASE_URL=postgresql+asyncpg://mindnest_app:mindnest_app@localhost:5432/mindnest
MIGRATION_DATABASE_URL=postgresql+asyncpg://mindnest:mindnest@localhost:5432/mindnest

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mindnest
S3_SECRET_KEY=mindnest-secret
S3_BUCKET=mindnest-materials

# Local embedding and rerank service (runs on the host so it can use the GPU).
MODEL_SERVICE_URL=http://localhost:8100
MODEL_BACKEND=sentence-transformers
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Account emails. Mailpit (http://localhost:8025) catches them in development.
WEB_BASE_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=MindNest AI <no-reply@mindnest.local>

# Where the Next.js server finds the API (read when `pnpm dev` or `next build` starts).
API_INTERNAL_URL=http://localhost:8000

# Chat (M3). Encrypts the AI provider keys students save in Settings. Use a long random value
# (for example the output of: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Changing it later makes every saved key unreadable. The API refuses to start with the default
# value unless ENVIRONMENT=development.
SECRET_KEY=dev-only-secret-change-me

# Sign in with Google (optional; leave empty to hide the button). Create an OAuth client in
# Google Cloud Console as described in docs/runbooks/google-oauth.md. The redirect URI to register is
#   http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Agents. Traces go to LangSmith only when AGENT_TRACING=true and a key is set, and only masked
# text is sent. Leave the standard LANGSMITH_TRACING variable unset: the app forces it off.
AGENT_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mindnest-ai

# Retrieval. How the word-search side of hybrid search orders its matches:
#   bm25        a real BM25 score computed in the API (see libs/core/mindnest_core/bm25.py) (default)
#   ts_rank_cd  Postgres's own cover-density rank
# Rebuild after changing it (the Evaluation Lab runs in eval-worker): docker compose up -d --build api worker eval-worker
RETRIEVAL_KEYWORD_RANKER=bm25

# What advanced mode (the chat default) reranks:
#   vector  the vector top 30 only (default)
#   hybrid  the vector top 30 merged with the keyword top 30, then reranked
# The Lab's four search methods (baseline, hybrid, advanced, advanced + hybrid) measure both.
# Rebuild with the command above after changing it.
RETRIEVAL_ADVANCED_CANDIDATES=vector
